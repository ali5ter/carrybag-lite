# ──────────────────────────────────────────────────────────────────────────────
# .env.template — Machine-specific overrides for carrybag-lite
#
# Copy to .env.local (gitignored) and edit values for your system:
#   cp .env.template .env.local
#
# Scripts that source this file:
#   bootstrap/install.sh           — OLLAMA_SERVER_DEFAULT, OPENCODE_MODEL_DEFAULT,
#                                   STARSHIP_HOSTNAME_ALIASES
#   opencode/install.sh            — HINDSIGHT_MCP_URL_DEFAULT
#   claude/register-hindsight-mcp.sh — HINDSIGHT_MCP_URL_DEFAULT (fallback for HINDSIGHT_URL)
#   claude/statusline-command.sh   — STARSHIP_HOSTNAME_ALIASES
#
# Format notes:
#   STARSHIP_HOSTNAME_ALIASES is semicolon-separated "host:alias" pairs, e.g.:
#     Alisters-iMac:imac;Alisters-MacBook-Air:mb-air
#   Lines starting with # are comments and are ignored.
#
# All variables have sensible defaults in the scripts themselves.
# Setting a variable here overrides the default for that installation.
# ──────────────────────────────────────────────────────────────────────────────

# Shared Ollama server (the Mac Studio) host:port. Deliberately an IP —
# Twingate may not resolve the FQDN (studio.diffnet.arpa) from external clients.
OLLAMA_SERVER_DEFAULT=192.168.1.63:11434

# Preferred OpenCode default model on the Ollama server; the installer falls back to
# whatever the endpoint serves if this model is absent.
OPENCODE_MODEL_DEFAULT=qwen3.6:35b-a3b-coding

# Hindsight MCP server URL on the same Mac Studio. Separate from OLLAMA_SERVER
# because it is a different service running on a different port.
# Also read as HINDSIGHT_URL by claude/register-hindsight-mcp.sh.
HINDSIGHT_MCP_URL_DEFAULT=http://192.168.1.63:8888/mcp/health/

# Starship hostname aliases — semicolon-separated "host:alias" pairs.
# These give shorthand names in the prompt / Claude Code statusline.
# Format: HostnameInShell:alias;HostnameInShell:alias (must be quoted due to semicolons)
STARSHIP_HOSTNAME_ALIASES="Alisters-iMac:imac;Alisters-MacBook-Air:mb-air;Alisters-Mac-Studio:studio"
